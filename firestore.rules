// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------- HELPERS -----------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "unknown";
    }

    function isAdmin() {
      return isSignedIn() && (
        userRole() == "admin"
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isContractor() {
      return isSignedIn() && (
        userRole() == "contractor"
        || exists(/databases/$(database)/documents/contractors/$(request.auth.uid))
      );
    }

    function isProvider() {
      return isSignedIn() && (
        userRole() == "provider"
        || exists(/databases/$(database)/documents/serviceProviders/$(request.auth.uid))
      );
    }

    function contractorRef() {
      return /databases/$(database)/documents/contractors/$(request.auth.uid);
    }

    // ----------------- USERS -----------------
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- ADMINS -----------------
    match /admins/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /adminInvites/{inviteId} {
      allow read, write: if false;
    }

    // ----------------- CLIENTS -----------------
    match /clients/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- CONTRACTORS -----------------
    match /contractors/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    // ----------------- SERVICE PROVIDERS (GLOBAL MIRROR) -----------------
    match /serviceProviders/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;

      // app queries this
      allow read: if isSignedIn();

      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);

      allow delete: if false;
    }

    // Contractor-owned subcollection providers
    match /contractors/{contractorId}/providers/{providerId} {
      // ✅ allow signed-in reads so client can resolve provider names if needed
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == contractorId;

      allow update: if isSignedIn() && (
        request.auth.uid == providerId
        || request.auth.uid == contractorId
        || isAdmin()
      );

      allow delete: if false;
    }

    // ----------------- PUBLIC DATA -----------------
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /repairs/{repairId} {
      allow read: if true;
      allow write: if false;
    }

    match /serviceTasks/{taskId} {
      allow read: if true;
      allow write: if false;
    }

    match /serviceCategories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repairSuggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repair_suggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------- JOB REQUESTS -----------------
    match /jobRequest/{jobId} {

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid;

      function isCancelledState() {
        return (resource.data.status is string) && (resource.data.status in [
          "cancelled",
          "cancelled_by_client",
          "cancelled_by_provider"
        ]);
      }

      function isClientOwner() {
        return isSignedIn()
          && (resource.data.clientId is string)
          && resource.data.clientId == request.auth.uid;
      }

      function isSelectedProvider() {
        return isSignedIn()
          && (resource.data.selectedProviderUid is string)
          && resource.data.selectedProviderUid == request.auth.uid;
      }

      function isMatchedProvider() {
        return isSignedIn()
          && (resource.data.matchedProviderIds is list)
          && (request.auth.uid in resource.data.matchedProviderIds);
      }

      // ✅ Contractor owns if jobRequest has contractorId (string) matching uid
      function contractorOwnsByJobField() {
        return isContractor()
          && (resource.data.contractorId is string)
          && resource.data.contractorId == request.auth.uid;
      }

      // ✅ Contractor owns if provider.managedBy points to contractor doc OR managedBy is contractor uid string
      function contractorOwnsByProviderManagedBy() {
        return isContractor()
          && (resource.data.selectedProviderUid is string)
          && exists(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid))
          && (
            // managedBy stored as DocumentReference
            (
              get(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid)).data.managedBy
              == contractorRef()
            )
            ||
            // managedBy stored as contractor uid string
            (
              get(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid)).data.managedBy is string
              && get(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid)).data.managedBy
                 == request.auth.uid
            )
            ||
            // contractorId stored as string on provider doc
            (
              get(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid)).data.contractorId is string
              && get(/databases/$(database)/documents/serviceProviders/$(resource.data.selectedProviderUid)).data.contractorId
                 == request.auth.uid
            )
          );
      }

      function contractorOwnsThisJob() {
        return contractorOwnsByJobField() || contractorOwnsByProviderManagedBy();
      }

      function providerCanRespondToJob() {
        return isSignedIn()
          && (resource.data.selectedProviderUid is string)
          && resource.data.selectedProviderUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["status", "providerDecisionAt", "providerResponseAt", "updatedAt"])
          && (request.resource.data.status in ["accepted", "declined"]);
      }

      function clientCanCancelJob() {
        return isSignedIn()
          && (resource.data.clientId is string)
          && resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["status", "cancelledAt", "stoppedAt", "updatedAt"])
          && (request.resource.data.status in ["cancelled"]);
      }

      function clientCanCancelAcceptedJob() {
        return isSignedIn()
          && (resource.data.clientId is string)
          && resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(["status", "cancelledAt", "updatedAt"])
          && (request.resource.data.status in ["cancelled_by_client"]);
      }

      // ✅ READ:
      // IMPORTANT: allow involved parties to read ALWAYS (even if "hidden"),
      // otherwise queries will throw permission-denied when hidden docs exist.
      allow read: if isAdmin()
        || isClientOwner()
        || isSelectedProvider()
        || contractorOwnsThisJob()
        || (isMatchedProvider() && !isCancelledState());

      // ✅ UPDATE:
      // Only strict client/provider actions from app.
      // Everything else happens via backend (Admin SDK bypasses rules).
      allow update: if isAdmin()
        || providerCanRespondToJob()
        || clientCanCancelJob()
        || clientCanCancelAcceptedJob();

      allow delete: if false;
    }

    // ----------------- QUOTATIONS -----------------
    match /quotations/{quotationId} {

      allow create: if isContractor()
        && request.resource.data.contractorId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.pricing is map
        && request.resource.data.tasks is list;

      allow read: if isAdmin()
        || (isContractor() && resource.data.contractorId == request.auth.uid)
        || (
          isSignedIn()
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobRequest/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobRequest/$(resource.data.jobId)).data.clientId
              == request.auth.uid
        )
        || (
          isProvider()
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobRequest/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobRequest/$(resource.data.jobId)).data.selectedProviderUid
              == request.auth.uid
        );

      allow update, delete: if false;
    }

    // ----------------- INVOICES -----------------
    match /invoices/{invoiceId} {

      allow create: if isContractor()
        && request.resource.data.contractorId == request.auth.uid
        && request.resource.data.jobId is string;

      allow read: if isAdmin()
        || (isContractor() && resource.data.contractorId == request.auth.uid)
        || (
          isSignedIn()
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobRequest/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobRequest/$(resource.data.jobId)).data.clientId
              == request.auth.uid
        )
        || (
          isProvider()
          && resource.data.jobId is string
          && exists(/databases/$(database)/documents/jobRequest/$(resource.data.jobId))
          && get(/databases/$(database)/documents/jobRequest/$(resource.data.jobId)).data.selectedProviderUid
              == request.auth.uid
        );

      allow update, delete: if false;
    }

    // ----------------- PAYMENTS -----------------
    match /payments/{paymentId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ----------------- JOBS -----------------
    match /jobs/{jobId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.clientId == request.auth.uid);

      allow create, update, delete: if false;
    }
  }
}
