rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow signed-in users to read provider profiles
    match /serviceProviders/{providerDocId} {
      allow read: if request.auth != null;
    }

    // ----------------- HELPERS -----------------
    function isSignedIn() {
      return request.auth != null;
    }

    // ✅ Safe role lookup (won't crash if users doc missing)
    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "unknown";
    }

    function isAdmin() {
      return isSignedIn() && userRole() == "admin";
    }

    function isClient() {
      return isSignedIn() && userRole() == "client";
    }

    function isProvider() {
      return isSignedIn() && userRole() == "provider";
    }

    // ✅ Provider access should NOT rely on role lookup
    function isSelectedProvider() {
      return isSignedIn()
        && resource.data.selectedProviderUid == request.auth.uid;
    }

    // Optional matched list support (no role check)
    function isMatchedProvider() {
      return isSignedIn()
        && (resource.data.matchedProviderIds is list)
        && (request.auth.uid in resource.data.matchedProviderIds);
    }

    // ✅ Provider can accept/decline only on selected jobs (field whitelist)
    function providerCanRespondToJob() {
      return isSignedIn()
        && resource.data.selectedProviderUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "providerDecisionAt", "updatedAt"])
        && (request.resource.data.status in ["accepted", "declined"]);
    }

    // ----------------- USERS (role store) -----------------
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- ADMINS -----------------
    match /admins/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Admin invitations (Admin SDK only)
    match /adminInvites/{inviteId} {
      allow read, write: if false;
    }

    // ----------------- CLIENTS -----------------
    match /clients/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- CONTRACTORS -----------------
    match /contractors/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;

      // (kept as you had) any signed-in user can read contractors
      allow read: if isSignedIn();

      // contractor self OR admin can update
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow delete: if false;
    }

    // ----------------- SERVICE PROVIDERS (top-level) -----------------
    match /serviceProviders/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;

      // provider can read/update their own provider doc
      allow read, update: if isSignedIn() && request.auth.uid == uid;

      // admin access
      allow read, update: if isAdmin();

      allow delete: if false;
    }

    // ----------------- CONTRACTOR -> providers subcollection -----------------
    match /contractors/{contractorId}/providers/{providerId} {
      // contractor creates provider docs
      allow create: if isSignedIn() && request.auth.uid == contractorId;

      // provider can read/update their own info
      allow read, update: if isSignedIn() && request.auth.uid == providerId;

      // contractor can read/update providers under them
      allow read, update: if isSignedIn() && request.auth.uid == contractorId;

      // admins can also read/update
      allow read, update: if isAdmin();

      allow delete: if false;
    }

    // ----------------- PUBLIC / CATALOG DATA -----------------
    // Your UI loads these lists; allow read without auth issues.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /repairs/{repairId} {
      allow read: if true;
      allow write: if false;
    }

    // ✅ You have this collection in your DB list
    match /serviceTasks/{taskId} {
      allow read: if true;
      allow write: if false;
    }

    // optional aliases (keep if your teammate uses these names)
    match /serviceCategories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repairSuggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repair_suggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------- JOB REQUESTS -----------------
    match /jobRequest/{jobId} {

      // Clients can create jobs for themselves
      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid;

      // READ:
      // - client owner
      // - admin
      // - selected provider
      // - matched provider
      allow read: if (isClient() && resource.data.clientId == request.auth.uid)
        || isAdmin()
        || isSelectedProvider()
        || isMatchedProvider();

      // UPDATE:
      // - client owner
      // - admin
      // - selected provider accept/decline only
      allow update: if (isClient() && resource.data.clientId == request.auth.uid)
        || isAdmin()
        || providerCanRespondToJob();

      allow delete: if false;
    }

    // ----------------- JOBS -----------------
    // ✅ Needed because your ClientJobs screen reads from /jobs
    match /jobs/{jobId} {

      // READ:
      // - client owner (based on clientId on the job doc)
      // - admin
      allow read: if (isClient() && resource.data.clientId == request.auth.uid)
        || isAdmin();

      // Keep writes locked (since you didn't specify any write logic here)
      allow create, update, delete: if false;
    }
  }
}
