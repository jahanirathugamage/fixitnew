// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /serviceProviders/{providerDocId} {
      allow read: if request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "unknown";
    }

    function isAdmin() {
      return isSignedIn() && userRole() == "admin";
    }

    function isClient() {
      return isSignedIn() && userRole() == "client";
    }

    function isProvider() {
      return isSignedIn() && userRole() == "provider";
    }

    function isSelectedProvider() {
      return isSignedIn()
        && resource.data.selectedProviderUid == request.auth.uid;
    }

    function isMatchedProvider() {
      return isSignedIn()
        && (resource.data.matchedProviderIds is list)
        && (request.auth.uid in resource.data.matchedProviderIds);
    }

    function providerCanRespondToJob() {
      return isSignedIn()
        && resource.data.selectedProviderUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "providerDecisionAt", "updatedAt"])
        && (request.resource.data.status in ["accepted", "declined"]);
    }

    // ✅ Client is allowed to cancel/stop ONLY via these fields
    function clientCanCancelJob() {
      return isSignedIn()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "cancelledAt", "stoppedAt", "updatedAt"])
        && (request.resource.data.status in ["cancelled"]);
    }

    // ✅ Client can cancel accepted job (future) via these fields
    function clientCanCancelAcceptedJob() {
      return isSignedIn()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "cancelledAt", "updatedAt"])
        && (request.resource.data.status in ["cancelled_by_client"]);
    }

    // ----------------- USERS -----------------
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- ADMINS -----------------
    match /admins/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /adminInvites/{inviteId} {
      allow read, write: if false;
    }

    // ----------------- CLIENTS -----------------
    match /clients/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ----------------- CONTRACTORS -----------------
    match /contractors/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if false;
    }

    // ----------------- SERVICE PROVIDERS -----------------
    match /serviceProviders/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /contractors/{contractorId}/providers/{providerId} {
      allow create: if isSignedIn() && request.auth.uid == contractorId;
      allow read, update: if isSignedIn() && request.auth.uid == providerId;
      allow read, update: if isSignedIn() && request.auth.uid == contractorId;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // ----------------- PUBLIC DATA -----------------
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /repairs/{repairId} {
      allow read: if true;
      allow write: if false;
    }

    match /serviceTasks/{taskId} {
      allow read: if true;
      allow write: if false;
    }

    match /serviceCategories/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repairSuggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /repair_suggestions/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------- JOB REQUESTS -----------------
    match /jobRequest/{jobId} {

      allow create: if isSignedIn()
        && request.resource.data.clientId == request.auth.uid;

      // ✅ Block reads for cancelled states (client + provider shouldn't view it anymore)
      function isCancelledState() {
        return resource.data.status in ["cancelled", "cancelled_by_client", "cancelled_by_provider"];
      }

      allow read: if isAdmin()
        || (
          !isCancelledState()
          && (
            (isClient() && resource.data.clientId == request.auth.uid)
            || isSelectedProvider()
            || isMatchedProvider()
          )
        );

      // UPDATE:
      // - admin
      // - provider accept/decline only
      // - client cancel/stop (to cancelled)
      // - client cancel accepted job (to cancelled_by_client)
      allow update: if isAdmin()
        || providerCanRespondToJob()
        || clientCanCancelJob()
        || clientCanCancelAcceptedJob();

      allow delete: if false;
    }

    // ----------------- JOBS -----------------
    match /jobs/{jobId} {
      allow read: if (isClient() && resource.data.clientId == request.auth.uid)
        || isAdmin();

      allow create, update, delete: if false;
    }
  }
}
