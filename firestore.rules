rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ✅ FIX: safe role lookup (prevents permission-denied when /users/{uid} missing)
    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "unknown";
    }

    // Helper: check if current user is an admin (users/{uid}.role == "admin")
    function isAdmin() {
      return isSignedIn() && userRole() == "admin";
    }

    function isClient() {
      return isSignedIn() && userRole() == "client";
    }

    function isProvider() {
      return isSignedIn() && userRole() == "provider";
    }

    // Provider can view a jobRequest ONLY if they are in matchedProviderIds OR selectedProviderId
    function providerCanViewJob() {
      return isProvider() && (
        (resource.data.matchedProviderIds is list && request.auth.uid in resource.data.matchedProviderIds) ||
        (resource.data.selectedProviderId == request.auth.uid)
      );
    }

    // USERS (role store)
    match /users/{uid} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == uid;
    }

    // ADMINS — only that admin can manage own admin profile
    match /admins/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ADMIN INVITATIONS (only Cloud Functions via Admin SDK)
    match /adminInvites/{inviteId} {
      allow read, write: if false;
    }

    // CLIENTS
    match /clients/{uid} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == uid;
    }

    // CONTRACTORS
    match /contractors/{uid} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;

      // Contractor themself OR any admin can update
      allow update: if request.auth != null &&
                    (request.auth.uid == uid || isAdmin());
    }

    // ✅ SERVICE PROVIDERS (top-level collection you actually use)
    match /serviceProviders/{uid} {
      allow create: if request.auth != null;

      // provider can read/update their own service provider doc
      allow read, update: if request.auth != null && request.auth.uid == uid;
    }

    // PROVIDERS under contractors (subcollection) - kept as-is
    match /contractors/{contractorId}/providers/{providerId} {

      // contractor creates providers
      allow create: if request.auth != null &&
                    request.auth.uid == contractorId;

      // provider can read/update their own info
      allow read, update: if request.auth != null &&
                          request.auth.uid == providerId;

      // contractor can manage providers
      allow read, update: if request.auth != null &&
                          request.auth.uid == contractorId;

      // admins can also read/update providers
      allow read, update: if isAdmin();
    }

    // PUBLIC SERVICE CATALOG
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // PUBLIC REPAIRS LIST
    match /repairs/{repairId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ================== JOBS ==================
    match /jobRequest/{jobId} {

      // Clients can create jobs for themselves
      allow create: if request.auth != null
                    && request.resource.data.clientId == request.auth.uid;

      // ✅ READ:
      // - client who owns it
      // - admin
      // - provider ONLY if matched/selected
      allow read: if (isClient() && resource.data.clientId == request.auth.uid)
                  || isAdmin()
                  || providerCanViewJob();

      // UPDATE:
      // keep your original policy: only client owner + admin
      // (later we’ll add provider update rules for hold/accept if needed)
      allow update: if (request.auth != null && resource.data.clientId == request.auth.uid)
                    || isAdmin();
    }
  }
}
